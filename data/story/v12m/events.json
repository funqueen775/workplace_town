      "durationMinutes": 60,
      "situation": "weak",
      "autoComplete": true,
      "beats": [
        {
          "type": "narration",
          "text": "入职第一天。你按通知来到 B 区训练室。陈工正在讲新人先熟悉团队和提交流程。"
        },
        {
          "type": "say",
          "speaker": "陈工",
          "text": "写你做过的事，别写你想做的事。谁做的，名字就写谁的。",
          "emphasis": [
            "谁做的，名字就写谁的"
          ]
        },
        {
          "type": "say",
          "speaker": "陈工",
          "text": "手册就在桌上，提交前可以看看那三问。我还有个会，先跟王哥认认路。"
        },
        {
          "type": "say",
          "speaker": "小赵",
          "text": "他每年都这么开场。你好，我是小赵，工位在你旁边。"
        },
        {
          "type": "say",
          "speaker": "王哥",
          "text": "我是王哥，技术导师。走，我带你看看工作区。"
        }
      ],
      "choices": [],
      "timeBand": "morning",
      "phase": "early",
      "reportUse": "story_only",
      "todayCard": {
        "title": "今天 · 入职说明会",
        "lines": [
          "第一天，陈工先讲清楚：做过的事要写下真实署名。",
          "散会后，王哥带你熟悉 A 区。",
          "上午，B 区训练室 → A 区总部。"
        ],
        "shots": [
          "place_card_tool_1.png"
        ]
      }
    },
